/* pages/index/index.wxss */
.wrap{padding:24rpx 28rpx 60rpx;}

.card{
  background:var(--card);
  border:1rpx solid var(--line);
  border-radius:24rpx;
  padding:26rpx;
  margin-bottom:26rpx;
  box-shadow:0 8rpx 30rpx rgba(0,0,0,0.35);
}

/* 置顶 */
.hero{
  background:linear-gradient(135deg, rgba(232,163,61,0.16), rgba(123,60,180,0.12));
  border-color:rgba(232,163,61,0.4);
}
.hero-title{font-size:34rpx;font-weight:700;letter-spacing:2rpx;}
.hero-sub{display:flex;align-items:center;justify-content:space-between;margin-top:16rpx;}
.hero-pill{font-size:24rpx;color:var(--ink-2);}
.hl{color:var(--amber-soft);font-weight:700;font-size:28rpx;}
.pts{
  font-size:24rpx;color:#1a1020;font-weight:700;
  background:var(--amber);padding:6rpx 20rpx;border-radius:30rpx;
}
.hero-warn{margin-top:14rpx;color:#ff9aa2;font-size:22rpx;}
.badge-chip{display:inline-block;margin-left:12rpx;font-size:20rpx;color:var(--amber-soft);background:rgba(232,163,61,0.14);border:1rpx solid var(--amber-glow);border-radius:30rpx;padding:2rpx 12rpx;}

/* 区块标题 */
.section-title{
  display:flex;align-items:center;gap:16rpx;margin:34rpx 4rpx 18rpx;
  font-size:30rpx;font-weight:700;color:var(--amber-soft);
}
.section-title .line{flex:1;height:1rpx;background:linear-gradient(90deg,var(--amber-glow),transparent);}

.tip{font-size:22rpx;color:var(--ink-3);display:block;margin-bottom:18rpx;}

/* 今日推荐 */
.today-card{
  display:flex;align-items:center;gap:18rpx;
  background:linear-gradient(135deg, rgba(232,163,61,0.14), rgba(123,60,180,0.10));
  border:1rpx solid var(--amber-glow);border-radius:24rpx;
  padding:22rpx;margin-bottom:26rpx;
}
.today-emoji{font-size:56rpx;}
.today-info{flex:1;min-width:0;}
.today-top{display:flex;align-items:center;gap:12rpx;}
.today-badge{font-size:20rpx;color:#1a1020;background:var(--amber);font-weight:700;padding:3rpx 14rpx;border-radius:30rpx;}
.today-date{font-size:20rpx;color:var(--ink-3);}
.today-cn{display:block;font-size:34rpx;font-weight:700;color:var(--amber-soft);margin-top:10rpx;}
.today-why{display:block;font-size:22rpx;color:var(--ink-2);margin-top:8rpx;line-height:1.5;}
.today-btn{flex-shrink:0;background:var(--amber);color:#1a1020;font-weight:700;font-size:24rpx;border-radius:40rpx;padding:12rpx 26rpx;border:none;}
.today-btn::after{border:none;}

/* 抽一杯 */
.mood.lucky{background:linear-gradient(135deg, rgba(232,163,61,0.18), rgba(123,60,180,0.14));border:1rpx dashed var(--amber-glow);}
.lucky-emoji{display:inline-block;animation:diceSpin 2.4s ease-in-out infinite;}
@keyframes diceSpin{0%,100%{transform:rotate(0) scale(1)}50%{transform:rotate(12deg) scale(1.08)}}
.mixing-sub{display:block;margin-top:10rpx;font-size:20rpx;color:var(--ink-3);}

/* 心情网格 */
.mood-grid{display:flex;flex-wrap:wrap;gap:16rpx;}
.mood{
  width:calc(33.3% - 12rpx);box-sizing:border-box;
  background:rgba(255,255,255,0.04);border:1rpx solid var(--line);
  border-radius:18rpx;padding:20rpx 0;text-align:center;
}
.mood.picked{border:1rpx solid var(--amber);background:var(--amber-glow);}
.mood-emoji{font-size:40rpx;display:block;}
.mood-name{font-size:24rpx;color:var(--ink-2);display:block;margin-top:8rpx;}

/* 按钮 */
.btn-primary{
  margin-top:20rpx;background:var(--amber);color:#1a1020;font-weight:700;
  border-radius:40rpx;font-size:28rpx;padding:18rpx 0;border:none;
}
.btn-primary::after{border:none;}

/* 点单卡 */
.order{margin-top:20rpx;text-align:center;}
.o-name{font-size:28rpx;color:var(--ink);font-weight:600;display:block;}
.o-en{font-size:22rpx;color:var(--ink-3);display:block;margin-top:6rpx;}
.o-hint{display:inline-block;margin-top:14rpx;font-size:22rpx;color:var(--ink-3);}

/* 摇酒 */
.mixing{margin-top:30rpx;text-align:center;padding:30rpx 0;}
.shaker{font-size:80rpx;display:inline-block;animation:shake 0.6s ease-in-out infinite;}
@keyframes shake{
  0%{transform:rotate(-14deg) translateY(0)}
  50%{transform:rotate(14deg) translateY(-10rpx)}
  100%{transform:rotate(-14deg) translateY(0)}
}
.mixing-txt{display:block;margin-top:16rpx;color:var(--amber-soft);font-size:24rpx;}

/* 酒卡 */
.drink{margin-top:18rpx;}
.drink-cn{font-size:40rpx;font-weight:700;color:var(--amber-soft);}
.drink-en{font-size:22rpx;color:var(--ink-3);margin-top:4rpx;}
.drink-base{font-size:24rpx;color:var(--ink-2);margin-top:14rpx;}
.drink-taste{font-size:26rpx;color:var(--ink);margin-top:16rpx;line-height:1.5;}
.how{margin-top:16rpx;font-size:24rpx;color:var(--green);line-height:1.5;}
.how-label{background:rgba(74,222,128,0.15);color:var(--green);padding:4rpx 12rpx;border-radius:8rpx;margin-right:10rpx;font-size:20rpx;}
.cure{margin-top:16rpx;font-size:26rpx;color:var(--ink-2);line-height:1.6;border-left:4rpx solid var(--amber);padding-left:16rpx;}

/* 卡片内分隔条 */
.card-divider{display:flex;align-items:center;gap:16rpx;margin:34rpx 0 20rpx;}
.cd-line{flex:1;height:1rpx;background:linear-gradient(90deg,transparent,var(--amber-glow),transparent);}
.cd-txt{font-size:24rpx;font-weight:700;color:var(--amber-soft);letter-spacing:2rpx;}

/* 酒卡按钮行 */
.act-row{display:flex;gap:16rpx;margin-top:20rpx;}
.btn-shelf,.btn-poster{flex:1;font-size:26rpx;border-radius:40rpx;padding:14rpx 0;border:none;}
.btn-shelf{background:rgba(232,163,61,0.12);color:var(--amber-soft);border:1rpx solid var(--amber-glow);}
.btn-shelf.saved{color:var(--ink-3);border-color:var(--line);}
.btn-poster{background:var(--amber);color:#1a1020;font-weight:700;}
.btn-shelf::after,.btn-poster::after{border:none;}

/* 酒柜入口 */
.shelf-entry{display:flex;align-items:center;justify-content:space-between;}
.shelf-entry-left{display:flex;align-items:center;gap:18rpx;}
.shelf-entry-emoji{font-size:52rpx;}
.shelf-entry-title{display:block;font-size:30rpx;font-weight:700;color:var(--amber-soft);}
.shelf-entry-sub{display:block;font-size:22rpx;color:var(--ink-3);margin-top:6rpx;}
.shelf-entry-arrow{font-size:44rpx;color:var(--ink-3);}

/* 入口组：酒柜/心情数据/我的 */
.entry-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;margin-bottom:26rpx;}
.entry-card{background:var(--card);border:1rpx solid var(--line);border-radius:22rpx;padding:24rpx 14rpx;text-align:center;}
.entry-emoji{display:block;font-size:44rpx;}
.entry-title{display:block;font-size:26rpx;font-weight:700;color:var(--ink);margin-top:12rpx;}
.entry-sub{display:block;font-size:20rpx;color:var(--ink-3);margin-top:6rpx;}

/* 酒柜 */
.shelf-empty{text-align:center;color:var(--ink-3);font-size:24rpx;padding:30rpx 0;}

/* 心情趋势 */
.trend-empty{text-align:center;color:var(--ink-3);font-size:24rpx;padding:30rpx 0;}
.trend-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14rpx;}
.trend-title{font-size:28rpx;font-weight:700;color:var(--amber-soft);}
.trend-sub{font-size:20rpx;color:var(--ink-3);}
.trend-canvas{width:100%;height:260rpx;}

/* 隐藏海报画布 */
.poster-canvas{position:fixed;left:-9999rpx;top:0;width:750rpx;height:1200rpx;}

/* 心事墙 */
.textarea{
  width:100%;box-sizing:border-box;background:rgba(0,0,0,0.25);
  border:1rpx solid var(--line);border-radius:16rpx;padding:18rpx;
  color:var(--ink);font-size:26rpx;height:150rpx;margin-bottom:16rpx;
}
.wall{margin-top:20rpx;}
.wall-item{
  background:rgba(255,255,255,0.03);border:1rpx solid var(--line);
  border-radius:16rpx;padding:18rpx;margin-bottom:14rpx;
}
.wall-item.done{opacity:0.55;}
.w-row{display:flex;justify-content:space-between;font-size:22rpx;color:var(--ink-3);}
.w-mood{color:var(--amber-soft);}
.w-content{display:block;font-size:27rpx;color:var(--ink);margin:10rpx 0;line-height:1.5;}
.w-cure{display:block;font-size:25rpx;color:var(--green);margin:10rpx 0;line-height:1.5;}
.w-release{display:inline-block;font-size:22rpx;color:var(--amber);margin-top:6rpx;}

/* 日记 */
.diary-row{margin-bottom:18rpx;}
.diary-label{font-size:24rpx;color:var(--ink-2);display:block;margin-bottom:6rpx;}
.input{
  width:100%;box-sizing:border-box;background:rgba(0,0,0,0.25);
  border:1rpx solid var(--line);border-radius:16rpx;padding:18rpx;
  color:var(--ink);font-size:26rpx;margin-bottom:16rpx;
}
.timeline{margin-top:20rpx;}
.tl-item{margin-bottom:16rpx;padding-bottom:16rpx;border-bottom:1rpx dashed var(--line);}
.tl-date{font-size:22rpx;color:var(--amber-soft);display:block;}
.tl-text{font-size:25rpx;color:var(--ink-2);display:block;margin-top:6rpx;line-height:1.5;}

.footer{text-align:center;color:var(--ink-3);font-size:22rpx;margin-top:30rpx;line-height:1.6;}
