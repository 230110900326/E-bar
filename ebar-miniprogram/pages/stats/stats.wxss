/* pages/stats/stats.wxss */
.wrap{padding:24rpx 28rpx 60rpx;}
.loading{text-align:center;color:var(--ink-3);font-size:26rpx;padding:80rpx 0;}

.section-title{
  display:flex;align-items:center;gap:16rpx;margin:34rpx 4rpx 18rpx;
  font-size:30rpx;font-weight:700;color:var(--amber-soft);
}
.section-title .line{flex:1;height:1rpx;background:linear-gradient(90deg,var(--amber-glow),transparent);}

.card{
  background:var(--card);border:1rpx solid var(--line);border-radius:24rpx;
  padding:26rpx;margin-bottom:26rpx;box-shadow:0 8rpx 30rpx rgba(0,0,0,0.35);
}

.stats-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;}
.stat-card{background:var(--card);border:1rpx solid var(--line);border-radius:20rpx;padding:24rpx 10rpx;text-align:center;}
.stat-card .v{display:block;font-size:38rpx;font-weight:700;color:var(--amber-soft);}
.stat-card .k{display:block;font-size:20rpx;color:var(--ink-3);margin-top:8rpx;}

.trend-empty{text-align:center;color:var(--ink-3);font-size:24rpx;padding:30rpx 0;}
.trend-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14rpx;}
.trend-title{font-size:28rpx;font-weight:700;color:var(--amber-soft);}
.trend-sub{font-size:20rpx;color:var(--ink-3);}
.trend-canvas{width:100%;height:280rpx;}

.timeline{margin-top:10rpx;}
.tl-item{margin-bottom:16rpx;padding-bottom:16rpx;border-bottom:1rpx dashed var(--line);}
.tl-date{font-size:22rpx;color:var(--amber-soft);display:block;}
.tl-text{font-size:25rpx;color:var(--ink-2);display:block;margin-top:6rpx;line-height:1.5;}
